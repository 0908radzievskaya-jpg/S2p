# Optional. Set a real address before production use:
# {
#     email admin@example.com
# }

# For immediate HTTPS without a custom domain, use:
# 194.113.209.237.sslip.io
#
# For a custom domain, create an A record pointing to 194.113.209.237
# and put that domain here. Caddy will obtain and renew Let's Encrypt
# certificates automatically after DNS resolves to the VPS.
194.113.209.237.sslip.io {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Strict-Transport-Security "max-age=15552000"
    }
    reverse_proxy 127.0.0.1:8765
}
